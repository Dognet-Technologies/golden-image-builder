# UKI firmata con il roothash della nuova root; 3 tentativi di avvio (articolo 5)
[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=@UPDATE_URL@/@IMAGE_ID@
MatchPattern=@IMAGE_ID@_@v.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=@IMAGE_ID@_@v+@l-@d.efi @IMAGE_ID@_@v+@l.efi @IMAGE_ID@_@v.efi
Mode=0444
TriesLeft=3
TriesDone=0
InstancesMax=2
